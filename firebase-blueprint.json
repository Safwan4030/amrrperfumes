{
  "entities": {
    "users": {
      "title": "Users",
      "description": "User profiles",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "name": { "type": "string" },
        "phone": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["email", "name"]
    },
    "orders": {
      "title": "Orders",
      "description": "Customer orders",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "items": { "type": "array" },
        "totalAmount": { "type": "number" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" },
        "emailConfirmationSent": { "type": "boolean" },
        "emailSentTo": { "type": "string" }
      },
      "required": ["userId", "items", "totalAmount"]
    },
    "messages": {
      "title": "Messages",
      "description": "Customer support and feedback inbox messages",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "message": { "type": "string" },
        "source": { "type": "string" },
        "createdAt": { "type": "string" },
        "read": { "type": "boolean" }
      },
      "required": ["message", "createdAt"]
    },
    "customers": {
      "title": "Customers",
      "description": "Customer contacts, emails, phone numbers, and marketing leads",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "email": { "type": "string" },
        "phone": { "type": "string" },
        "source": { "type": "string" },
        "optedInOffers": { "type": "boolean" },
        "totalOrders": { "type": "number" },
        "totalSpent": { "type": "number" },
        "city": { "type": "string" },
        "createdAt": { "type": "string" },
        "lastActiveAt": { "type": "string" }
      },
      "required": ["createdAt"]
    },
    "site_analytics": {
      "title": "Site Analytics",
      "description": "Site visitor counters and traffic analytics",
      "type": "object",
      "properties": {
        "totalVisits": { "type": "number" },
        "uniqueVisitors": { "type": "number" },
        "todayVisits": { "type": "number" },
        "lastVisitDate": { "type": "string" },
        "lastVisitAt": { "type": "string" }
      }
    },
    "financial_accounts": {
      "title": "Financial Accounts",
      "description": "Store wallets, bank accounts, cash registers and Razorpay accounts",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "type": { "type": "string" },
        "openingBalance": { "type": "number" },
        "currentBalance": { "type": "number" },
        "totalMoneyIn": { "type": "number" },
        "totalMoneyOut": { "type": "number" },
        "accountNumber": { "type": "string" },
        "bankName": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" },
        "updatedAt": { "type": "string" }
      },
      "required": ["name", "type"]
    },
    "accounting_transactions": {
      "title": "Accounting Transactions",
      "description": "Master financial transaction ledger (Sales, Expenses, Refunds, Transfers)",
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "type": { "type": "string" },
        "amount": { "type": "number" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "accountId": { "type": "string" },
        "accountName": { "type": "string" },
        "toAccountId": { "type": "string" },
        "toAccountName": { "type": "string" },
        "orderId": { "type": "string" },
        "customerName": { "type": "string" },
        "customerEmail": { "type": "string" },
        "vendorName": { "type": "string" },
        "paymentMethod": { "type": "string" },
        "paymentStatus": { "type": "string" },
        "razorpayPaymentId": { "type": "string" },
        "razorpayOrderId": { "type": "string" },
        "referenceNumber": { "type": "string" },
        "notes": { "type": "string" },
        "cogs": { "type": "number" },
        "createdAt": { "type": "string" }
      },
      "required": ["date", "type", "amount", "category"]
    },
    "expenses": {
      "title": "Expenses",
      "description": "Operating expenses, materials, ads and packaging expenses",
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "description": { "type": "string" },
        "category": { "type": "string" },
        "supplier": { "type": "string" },
        "amount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "accountId": { "type": "string" },
        "accountName": { "type": "string" },
        "referenceNumber": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["date", "description", "category", "amount"]
    },
    "transfers": {
      "title": "Transfers",
      "description": "Internal money transfers between cash, bank, and payment accounts",
      "type": "object",
      "properties": {
        "date": { "type": "string" },
        "fromAccountId": { "type": "string" },
        "fromAccountName": { "type": "string" },
        "toAccountId": { "type": "string" },
        "toAccountName": { "type": "string" },
        "amount": { "type": "number" },
        "referenceNumber": { "type": "string" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["date", "fromAccountId", "toAccountId", "amount"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/users" },
      "description": "User account profiles"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/orders" },
      "description": "Store orders and line items"
    },
    "/messages/{messageId}": {
      "schema": { "$ref": "#/entities/messages" },
      "description": "Customer contact messages and atelier feedback"
    },
    "/customers/{customerId}": {
      "schema": { "$ref": "#/entities/customers" },
      "description": "Customer directory, leads and contact data"
    },
    "/site_analytics/{docId}": {
      "schema": { "$ref": "#/entities/site_analytics" },
      "description": "Aggregated site visitor counters"
    },
    "/financial_accounts/{accountId}": {
      "schema": { "$ref": "#/entities/financial_accounts" },
      "description": "Store accounts and balance ledgers"
    },
    "/accounting_transactions/{transactionId}": {
      "schema": { "$ref": "#/entities/accounting_transactions" },
      "description": "Financial accounting master journal entries"
    },
    "/expenses/{expenseId}": {
      "schema": { "$ref": "#/entities/expenses" },
      "description": "Operating expense documents"
    },
    "/transfers/{transferId}": {
      "schema": { "$ref": "#/entities/transfers" },
      "description": "Account transfer log records"
    }
  }
}
