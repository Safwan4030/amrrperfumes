rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all unspecified collections
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'safwaanvv@gmail.com' ||
        request.auth.token.email == 'amrrparfumes@gmail.com' ||
        request.auth.token.email == 'amrrperfumes@gmail.com'
      );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Products:
    // - read: public (accessible by all storefront customers, mobile devices, desktop, and incognito sessions)
    // - write: permitted for store operations (create, update, delete)
    match /products/{productId} {
      allow read, write: if true;
    }

    // User profiles:
    match /users/{userId} {
      allow read, write: if true;
    }

    // Orders:
    match /orders/{orderId} {
      allow read, write: if true;
    }

    // Messages / Support Inbox:
    match /messages/{messageId} {
      allow read, write: if true;
    }

    // Customers / CRM leads:
    match /customers/{customerId} {
      allow read, write: if true;
    }

    // Site Analytics:
    match /site_analytics/{docId} {
      allow read, write: if true;
    }

    // Financial Accounting & Ledger:
    match /expenses/{docId} {
      allow read, write: if true;
    }
    match /accounting_transactions/{docId} {
      allow read, write: if true;
    }
    match /financial_accounts/{docId} {
      allow read, write: if true;
    }
    match /account_transfers/{docId} {
      allow read, write: if true;
    }
  }
}
